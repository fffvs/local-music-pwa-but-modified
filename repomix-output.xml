		})

		it('preserves the source return gap when a batch deletes the manual track then its anchor', () => {
			seedTrack(1)
			seedTrack(2)
			seedTrack(3)
			seedTrack(9)
			player.playFrom(1, [1, 2, 3])
			player.queue.enqueue([9], 'next')
			player.playNext()
			flushSync()
			vi.clearAllMocks()

			dispatchTrackDeletes([9, 2])

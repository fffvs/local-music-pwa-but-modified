		})

		it('advances to the source successor rather than restarting the return point', () => {
			seedTrack(1)
			seedTrack(2)
			seedTrack(9)
			player.playFrom(0, [1, 2])
			player.queue.enqueue([9], 'next')
			player.playNext()
			flushSync()
			vi.clearAllMocks()

			dispatchTrackDelete(9)

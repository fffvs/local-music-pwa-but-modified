	.slider {
		--slider-size: calc(100% - --spacing(1));
	}

	.horizontal-input:not(:disabled):is(:active, :focus-visible) ~ div > .thumb {
		transform: scaleX(0.5);
	}
	.vertical-input:not(:disabled):is(:active, :focus-visible) ~ div > .thumb {

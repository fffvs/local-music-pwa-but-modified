			vi.clearAllMocks()

			ctrl.duration = 30
			ctrl.currentTime = 25
			flushSync()

			expect(ctrl.abortNext).toHaveBeenCalled()
			expect(ctrl.preloadNext).not.toHaveBeenCalled()
		})
	})

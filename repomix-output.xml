		tooltip?: string
		children?: Snippet
		onclick?: (event: MouseEvent) => void
		onpointerdown?: (event: PointerEvent) => void
	}
</script>

<script lang="ts" generics="As extends AllowedButtonElement = 'button'">
	const {
		as = 'button' as As,
		kind = 'filled',
